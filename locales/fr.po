#: src/index.ts:100
msgid "Insert PlantUML block template"
msgstr "Insérer un modèle de bloc PlantUML"

#: src/index.ts:124
msgid "Copy image"
msgstr "Copier l’image"

#: src/index.ts:125
msgid "Copy image address"
msgstr "Copier l’adresse de l’image"

#: src/settings.ts:21
msgid "Official public server"
msgstr "Serveur public officiel"

#: src/settings.ts:21
msgid "Private server"
msgstr "Serveur privé"

#: src/settings.ts:22
msgid "Vector Image (svg)"
msgstr "Image vectorielle (svg)"

#: src/settings.ts:22
msgid "Raster Image (png)"
msgstr "Image matricielle (png)"

#: src/settings.ts:22
