msgstr "Art ASCII (txt)"

#: src/settings.ts:44
msgid "Rendering: Type"
msgstr "Rendu : type"

#: src/settings.ts:45
#, c-format
msgid "Type of renderer used to parse the PlantUML syntax and create the image. %s: %s ; %s: Host taken from the next option"
msgstr "Type de moteur de rendu utilisé pour analyser la syntaxe PlantUML et créer l’image. %s : %s ; %s : hôte défini dans l’option suivante"

#: src/settings.ts:53
msgid "Rendering: Private server host (optional)"
msgstr "Rendu : hôte du serveur privé (facultatif)"

#: src/settings.ts:54
#, c-format
msgid "Private rendering server for plantUML. This server is used only if the Rendering Type is \"%s\""
msgstr "Serveur de rendu privé pour PlantUML. Ce serveur n’est utilisé que si le type de rendu est « %s »"

#: src/settings.ts:64
msgid "Rendering: Output image format"
msgstr "Rendu : format de l’image générée"

#: src/settings.ts:65
msgid "Type of image format generated while rendering the diagram."
msgstr "Format d’image généré lors du rendu du diagramme."

#: src/settings.ts:73
msgid "Diagram: Header file"
msgstr "Diagramme : fichier d’en-tête"

#: src/settings.ts:74
msgid "Path to the file containing the diagram header. The content of this file will be injected at the begin of each plantUML diagram in your notes."
msgstr "Chemin du fichier contenant l’en-tête des diagrammes. Le contenu de ce fichier sera inséré au début de chaque diagramme PlantUML de vos notes."

#: src/settings.ts:107
#, c-format
msgid "PlantUML allows you to render UML diagrams using the syntax defined at %s. For more info on the plugin: %s"
msgstr "PlantUML permet de dessiner des diagrammes UML avec la syntaxe définie sur %s. Plus d’informations sur le plugin : %s"

#: src/view.ts:37
msgid "PlantUML Diagram"
msgstr "Diagramme PlantUML"

#: src/view.ts:64
msgid "PlantUML Error:"
msgstr "Erreur PlantUML :"
