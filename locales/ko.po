#: src/index.ts:100
msgid "Insert PlantUML block template"
msgstr "PlantUML 블록 템플릿 삽입"

#: src/index.ts:124
msgid "Copy image"
msgstr "이미지 복사"

#: src/index.ts:125
msgid "Copy image address"
msgstr "이미지 주소 복사"

#: src/settings.ts:21
msgid "Official public server"
msgstr "공식 공개 서버"

#: src/settings.ts:21
msgid "Private server"
msgstr "개인 서버"

#: src/settings.ts:22
msgid "Vector Image (svg)"
msgstr "벡터 이미지 (svg)"

#: src/settings.ts:22
msgid "Raster Image (png)"
msgstr "래스터 이미지 (png)"

#: src/settings.ts:22
msgid "AsciiArt (txt)"
msgstr "아스키 아트 (txt)"

#: src/settings.ts:44
msgid "Rendering: Type"
msgstr "렌더링: 유형"

#: src/settings.ts:45
#, c-format
msgid "Type of renderer used to parse the PlantUML syntax and create the image. %s: %s ; %s: Host taken from the next option"
msgstr "PlantUML 구문을 분석하여 이미지를 생성하는 렌더러의 유형입니다. %s: %s ; %s: 다음 옵션에서 지정한 호스트"

#: src/settings.ts:53
msgid "Rendering: Private server host (optional)"
msgstr "렌더링: 개인 서버 호스트 (선택 사항)"

#: src/settings.ts:54
#, c-format
msgid "Private rendering server for plantUML. This server is used only if the Rendering Type is \"%s\""
msgstr "PlantUML용 개인 렌더링 서버입니다. 이 서버는 렌더링 유형이 \"%s\"인 경우에만 사용됩니다"

#: src/settings.ts:64
msgid "Rendering: Output image format"
msgstr "렌더링: 출력 이미지 형식"

#: src/settings.ts:65
msgid "Type of image format generated while rendering the diagram."
msgstr "다이어그램을 렌더링할 때 생성되는 이미지 형식입니다."

#: src/settings.ts:73
msgid "Diagram: Header file"
msgstr "다이어그램: 헤더 파일"

#: src/settings.ts:74
msgid "Path to the file containing the diagram header. The content of this file will be injected at the begin of each plantUML diagram in your notes."
msgstr "다이어그램 헤더가 포함된 파일의 경로입니다. 이 파일의 내용은 노트에 있는 각 PlantUML 다이어그램의 시작 부분에 삽입됩니다."

#: src/settings.ts:107
#, c-format
msgid "PlantUML allows you to render UML diagrams using the syntax defined at %s. For more info on the plugin: %s"
msgstr "PlantUML을 사용하면 %s에 정의된 구문으로 UML 다이어그램을 그릴 수 있습니다. 플러그인 정보: %s"

#: src/view.ts:37
msgid "PlantUML Diagram"
msgstr "PlantUML 다이어그램"

#: src/view.ts:64
msgid "PlantUML Error:"
msgstr "PlantUML 오류:"
