#: src/settings.ts:44
msgid "Rendering: Type"
msgstr "Renderização: tipo"

#: src/settings.ts:45
#, c-format
msgid "Type of renderer used to parse the PlantUML syntax and create the image. %s: %s ; %s: Host taken from the next option"
msgstr "Tipo de renderizador usado para interpretar a sintaxe do PlantUML e criar a imagem. %s: %s ; %s: host informado na próxima opção"

#: src/settings.ts:53
msgid "Rendering: Private server host (optional)"
msgstr "Renderização: host do servidor privado (opcional)"

#: src/settings.ts:54
#, c-format
msgid "Private rendering server for plantUML. This server is used only if the Rendering Type is \"%s\""
msgstr "Servidor de renderização privado para o PlantUML. Este servidor só é usado se o tipo de renderização for \"%s\""

#: src/settings.ts:64
msgid "Rendering: Output image format"
msgstr "Renderização: formato da imagem de saída"

#: src/settings.ts:65
msgid "Type of image format generated while rendering the diagram."
msgstr "Formato de imagem gerado ao renderizar o diagrama."

#: src/settings.ts:73
msgid "Diagram: Header file"
msgstr "Diagrama: arquivo de cabeçalho"

#: src/settings.ts:74
msgid "Path to the file containing the diagram header. The content of this file will be injected at the begin of each plantUML diagram in your notes."
msgstr "Caminho do arquivo que contém o cabeçalho dos diagramas. O conteúdo deste arquivo será inserido no início de cada diagrama PlantUML das suas notas."

#: src/settings.ts:107
#, c-format
msgid "PlantUML allows you to render UML diagrams using the syntax defined at %s. For more info on the plugin: %s"
msgstr "O PlantUML permite desenhar diagramas UML usando a sintaxe definida em %s. Mais informações sobre o plugin: %s"

#: src/view.ts:37
msgid "PlantUML Diagram"
msgstr "Diagrama PlantUML"

