msgid "Copy image address"
msgstr "Copiar dirección de la imagen"

#: src/settings.ts:21
msgid "Official public server"
msgstr "Servidor público oficial"

#: src/settings.ts:21
msgid "Private server"
msgstr "Servidor privado"

