msgstr "Arte ASCII (txt)"

#: src/settings.ts:44
msgid "Rendering: Type"
msgstr "Renderizado: tipo"

#: src/settings.ts:45
#, c-format
msgid "Type of renderer used to parse the PlantUML syntax and create the image. %s: %s ; %s: Host taken from the next option"
msgstr "Tipo de renderizador usado para analizar la sintaxis de PlantUML y crear la imagen. %s: %s ; %s: host indicado en la siguiente opción"

#: src/settings.ts:53
msgid "Rendering: Private server host (optional)"
msgstr "Renderizado: host del servidor privado (opcional)"

#: src/settings.ts:54
#, c-format
msgid "Private rendering server for plantUML. This server is used only if the Rendering Type is \"%s\""
msgstr "Servidor de renderizado privado para PlantUML. Este servidor solo se usa si el tipo de renderizado es «%s»"

#: src/settings.ts:64
msgid "Rendering: Output image format"
msgstr "Renderizado: formato de la imagen de salida"

#: src/settings.ts:65
msgid "Type of image format generated while rendering the diagram."
msgstr "Formato de imagen que se genera al renderizar el diagrama."

#: src/settings.ts:73
msgid "Diagram: Header file"
msgstr "Diagrama: archivo de cabecera"

#: src/settings.ts:74
msgid "Path to the file containing the diagram header. The content of this file will be injected at the begin of each plantUML diagram in your notes."
msgstr "Ruta del archivo que contiene la cabecera de los diagramas. El contenido de este archivo se insertará al principio de cada diagrama PlantUML de tus notas."

#: src/settings.ts:107
#, c-format
msgid "PlantUML allows you to render UML diagrams using the syntax defined at %s. For more info on the plugin: %s"
msgstr "PlantUML permite dibujar diagramas UML con la sintaxis definida en %s. Más información sobre el complemento: %s"

#: src/view.ts:37
msgid "PlantUML Diagram"
msgstr "Diagrama PlantUML"

#: src/view.ts:64
msgid "PlantUML Error:"
msgstr "Error de PlantUML:"
