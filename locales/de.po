msgstr "ASCII-Art (txt)"

#: src/settings.ts:44
msgid "Rendering: Type"
msgstr "Rendering: Typ"

#: src/settings.ts:45
#, c-format
msgid "Type of renderer used to parse the PlantUML syntax and create the image. %s: %s ; %s: Host taken from the next option"
msgstr "Art des Renderers, der die PlantUML-Syntax verarbeitet und das Bild erzeugt. %s: %s ; %s: Host aus der nächsten Option"

#: src/settings.ts:53
msgid "Rendering: Private server host (optional)"
msgstr "Rendering: Host des privaten Servers (optional)"

#: src/settings.ts:54
#, c-format
msgid "Private rendering server for plantUML. This server is used only if the Rendering Type is \"%s\""
msgstr "Privater Rendering-Server für PlantUML. Dieser Server wird nur verwendet, wenn der Rendering-Typ „%s“ ist"

#: src/settings.ts:64
msgid "Rendering: Output image format"
msgstr "Rendering: Ausgabe-Bildformat"

#: src/settings.ts:65
msgid "Type of image format generated while rendering the diagram."
msgstr "Bildformat, das beim Rendern des Diagramms erzeugt wird."

#: src/settings.ts:73
msgid "Diagram: Header file"
msgstr "Diagramm: Header-Datei"

#: src/settings.ts:74
msgid "Path to the file containing the diagram header. The content of this file will be injected at the begin of each plantUML diagram in your notes."
msgstr "Pfad zur Datei mit dem Diagramm-Header. Der Inhalt dieser Datei wird am Anfang jedes PlantUML-Diagramms in deinen Notizen eingefügt."

#: src/settings.ts:107
#, c-format
msgid "PlantUML allows you to render UML diagrams using the syntax defined at %s. For more info on the plugin: %s"
msgstr "Mit PlantUML kannst du UML-Diagramme mit der unter %s definierten Syntax darstellen. Weitere Informationen zum Plugin: %s"

#: src/view.ts:37
msgid "PlantUML Diagram"
msgstr "PlantUML-Diagramm"

#: src/view.ts:64
msgid "PlantUML Error:"
msgstr "PlantUML-Fehler:"
