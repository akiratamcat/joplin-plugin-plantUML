#: src/index.ts:124
msgid "Copy image"
msgstr "Bild kopieren"

#: src/index.ts:125
msgid "Copy image address"
msgstr "Bildadresse kopieren"

#: src/settings.ts:21
msgid "Official public server"
msgstr "Offizieller öffentlicher Server"

#: src/settings.ts:21
msgid "Private server"
msgstr "Privater Server"

#: src/settings.ts:22
