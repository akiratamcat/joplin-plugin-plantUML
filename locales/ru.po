#: src/index.ts:100
msgid "Insert PlantUML block template"
msgstr "Вставить шаблон блока PlantUML"

#: src/index.ts:124
msgid "Copy image"
msgstr "Копировать изображение"

#: src/index.ts:125
msgid "Copy image address"
msgstr "Копировать адрес изображения"

#: src/settings.ts:21
msgid "Official public server"
msgstr "Официальный публичный сервер"

#: src/settings.ts:21
msgid "Private server"
msgstr "Частный сервер"

#: src/settings.ts:22
msgid "Vector Image (svg)"
msgstr "Векторное изображение (svg)"

#: src/settings.ts:22
msgid "Raster Image (png)"
msgstr "Растровое изображение (png)"

#: src/settings.ts:22
msgid "AsciiArt (txt)"
msgstr "ASCII-графика (txt)"

#: src/settings.ts:44
msgid "Rendering: Type"
msgstr "Отрисовка: тип"

#: src/settings.ts:45
#, c-format
msgid "Type of renderer used to parse the PlantUML syntax and create the image. %s: %s ; %s: Host taken from the next option"
msgstr "Тип модуля отрисовки, который разбирает синтаксис PlantUML и создаёт изображение. %s: %s ; %s: хост из следующего параметра"

#: src/settings.ts:53
msgid "Rendering: Private server host (optional)"
msgstr "Отрисовка: хост частного сервера (необязательно)"

#: src/settings.ts:54
#, c-format
msgid "Private rendering server for plantUML. This server is used only if the Rendering Type is \"%s\""
msgstr "Частный сервер отрисовки для PlantUML. Этот сервер используется, только если выбран тип отрисовки «%s»"

#: src/settings.ts:64
msgid "Rendering: Output image format"
msgstr "Отрисовка: формат выходного изображения"

#: src/settings.ts:65
msgid "Type of image format generated while rendering the diagram."
msgstr "Формат изображения, создаваемого при отрисовке диаграммы."

#: src/settings.ts:73
msgid "Diagram: Header file"
msgstr "Диаграмма: файл заголовка"

#: src/settings.ts:74
msgid "Path to the file containing the diagram header. The content of this file will be injected at the begin of each plantUML diagram in your notes."
msgstr "Путь к файлу с заголовком диаграмм. Содержимое этого файла будет вставлено в начало каждой диаграммы PlantUML в ваших заметках."

#: src/settings.ts:107
#, c-format
msgid "PlantUML allows you to render UML diagrams using the syntax defined at %s. For more info on the plugin: %s"
msgstr "PlantUML позволяет рисовать UML-диаграммы с помощью синтаксиса, описанного на %s. Подробнее о плагине: %s"

#: src/view.ts:37
msgid "PlantUML Diagram"
msgstr "Диаграмма PlantUML"

#: src/view.ts:64
msgid "PlantUML Error:"
msgstr "Ошибка PlantUML:"
