msgid "Copy image address"
msgstr "Copia indirizzo immagine"

#: src/settings.ts:21
msgid "Official public server"
msgstr "Server pubblico ufficiale"

#: src/settings.ts:21
msgid "Private server"
msgstr "Server privato"

#: src/settings.ts:22
